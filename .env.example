# Required
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# LLM — Groq free tier (recommended)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
# Fast free production model on Groq
GROQ_MODEL=llama-3.1-8b-instant
# Fallbacks if primary is rate-limited
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,llama-3.3-70b-versatile

# Optional backup provider (free models on OpenRouter)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Market data (optional but recommended)
FINNHUB_API_KEY=

# Google OAuth (optional — Gmail/Calendar/Drive/Sheets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-public-domain.com/oauth/callback
OAUTH_SERVER_PORT=8000

# Runtime
DATABASE_URL=sqlite+aiosqlite:////app/data/atlas.db
ENVIRONMENT=production
LOG_LEVEL=INFO
DAILY_BRIEFING_HOUR=8
DAILY_BRIEFING_MINUTE=30
TIMEZONE=Asia/Kolkata
