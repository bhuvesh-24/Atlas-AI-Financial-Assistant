# Required
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# LLM (at least one)
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Market data (optional but recommended)
FINNHUB_API_KEY=

# Voice transcription (optional)
GROQ_API_KEY=

# Google OAuth (optional — enables Gmail/Calendar/Drive/Sheets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-public-domain.com/oauth/callback
OAUTH_SERVER_PORT=8000

# Runtime
DATABASE_URL=sqlite+aiosqlite:////app/data/atlas.db
ENVIRONMENT=production
LOG_LEVEL=INFO
DAILY_BRIEFING_HOUR=8
DAILY_BRIEFING_MINUTE=30
TIMEZONE=Asia/Kolkata
